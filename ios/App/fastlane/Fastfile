require "fileutils"
require "tmpdir"

default_platform(:ios)

platform :ios do
  def asc_api_key
    # CI sets ASC_KEY_PATH (not APP_STORE_CONNECT_API_KEY_PATH to avoid fastlane auto-detection conflict)
    key_path = ENV["ASC_KEY_PATH"] || File.join(Dir.pwd, "keys", "AuthKey.p8")
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path
    )
  end

  desc "Build release IPA"
  lane :build do
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: "YG929B6RG3",
      code_sign_identity: "Apple Distribution",
      profile_name: "Stuga App Store",
      targets: ["App"]
    )
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      clean: true,
      export_method: "app-store",
      disable_xcpretty: true,
      export_options: {
        signingStyle: "manual",
        teamID: "YG929B6RG3",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.twinbolt.stuga" => "Stuga App Store"
        }
      },
      output_directory: "./build",
      output_name: "Stuga.ipa"
    )
  end

  desc "Upload dSYMs to Firebase Crashlytics"
  lane :upload_dsyms do
    download_dsyms(
      app_identifier: "com.twinbolt.stuga"
    )
    upload_symbols_to_crashlytics(
      gsp_path: "../App/GoogleService-Info.plist"
    )
    clean_build_artifacts
  end

  desc "Upload to TestFlight (build + upload)"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload pre-built IPA to TestFlight"
  lane :testflight do
    release_notes_path = File.join(__dir__, "metadata/en-US/release_notes.txt")
    changelog = File.exist?(release_notes_path) ? File.read(release_notes_path).strip : nil
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: "./build/Stuga.ipa",
      skip_waiting_for_build_processing: true,
      changelog: changelog
    )
  end

  desc "Deploy to App Store"
  lane :release do
    build
    upload_to_app_store(
      api_key: asc_api_key,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload pre-built IPA to App Store"
  lane :upload do
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: "./build/Stuga.ipa",
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload only release_notes.txt to App Store Connect for the given APP_VERSION"
  lane :release_notes do
    source = File.join(__dir__, "metadata/en-US/release_notes.txt")
    unless File.exist?(source)
      UI.important("No release_notes.txt found, skipping App Store Connect notes push")
      next
    end

    app_version = ENV["APP_VERSION"]
    if app_version.nil? || app_version.strip.empty?
      UI.user_error!("APP_VERSION env var is required (e.g. set from the release tag)")
    end

    Dir.mktmpdir("stuga-release-notes") do |tmp|
      locale_dir = File.join(tmp, "en-US")
      FileUtils.mkdir_p(locale_dir)
      FileUtils.cp(source, File.join(locale_dir, "release_notes.txt"))

      upload_to_app_store(
        api_key: asc_api_key,
        app_version: app_version.strip,
        metadata_path: tmp,
        skip_binary_upload: true,
        skip_screenshots: true,
        force: true,
        precheck_include_in_app_purchases: false
      )
    end
  end

  desc "Upload metadata only (no build)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Submit an existing TestFlight build to App Store review (phased release)"
  lane :submit do
    app_version = ENV["APP_VERSION"]
    if app_version.nil? || app_version.strip.empty?
      UI.user_error!("APP_VERSION env var is required (e.g. 0.3.38)")
    end

    upload_to_app_store(
      api_key: asc_api_key,
      app_version: app_version.strip,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
